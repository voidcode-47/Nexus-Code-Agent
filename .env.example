# ===== Nexus-Code-Agent 环境配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# --- 应用 ---
NEXUS_APP_NAME=Nexus-Code-Agent
NEXUS_ENV=dev                 # dev | prod | test
NEXUS_DEBUG=true
NEXUS_LOG_LEVEL=INFO
NEXUS_LOG_JSON=true

# --- HTTP 服务网关 ---
NEXUS_API__HOST=127.0.0.1     # 默认仅监听本机；容器 / 局域网部署改为 0.0.0.0
NEXUS_API__PORT=8000
NEXUS_API__CORS_ORIGINS=*     # 显式来源（逗号分隔）时才允许携带凭证
NEXUS_API__AUTH_TOKEN=              # 留空则关闭鉴权（仅 dev）；NEXUS_ENV=prod 时未配置将拒绝启动
NEXUS_API__REQUEST_TIMEOUT_S=900   # 任务级超时（秒）：整条自愈任务上限，超时终止为 ERROR；0=关闭
NEXUS_API__ALLOWED_REPO_ROOTS=      # 逗号分隔白名单；NEXUS_ENV=prod 时必配，未配置将拒绝启动

# --- 检索与向量库 (Qdrant) ---
NEXUS_RETRIEVAL__QDRANT_URL=http://localhost:6333
NEXUS_RETRIEVAL__QDRANT_API_KEY=
NEXUS_RETRIEVAL__COLLECTION=nexus_code
NEXUS_RETRIEVAL__EMBEDDING_DIM=256
NEXUS_RETRIEVAL__TOP_K=12
NEXUS_RETRIEVAL__RRF_K=60
NEXUS_RETRIEVAL__USE_QDRANT=true     # false 时使用内存向量库（离线模式）
NEXUS_RETRIEVAL__BM25_WEIGHT=1.0     # RRF 融合权重
NEXUS_RETRIEVAL__DENSE_WEIGHT=1.0

# --- LLM ---
NEXUS_LLM__PROVIDER=heuristic        # heuristic | openai | deepseek
NEXUS_LLM__API_KEY=
NEXUS_LLM__BASE_URL=https://api.openai.com/v1
NEXUS_LLM__MODEL=gpt-4o-mini
NEXUS_LLM__TEMPERATURE=0.1
NEXUS_LLM__MAX_TOKENS=4096
NEXUS_LLM__REQUEST_TIMEOUT_S=120

# --- 沙箱 ---
NEXUS_SANDBOX__BACKEND=local         # local | docker
NEXUS_SANDBOX__IMAGE=nexus-sandbox:latest   # docker 后端镜像：make sandbox-image
NEXUS_SANDBOX__POOL_SIZE=2
NEXUS_SANDBOX__CPU_LIMIT=2.0
NEXUS_SANDBOX__MEMORY_LIMIT_MB=2048
NEXUS_SANDBOX__TEST_TIMEOUT_S=300
NEXUS_SANDBOX__COMMAND_TIMEOUT_S=120
NEXUS_SANDBOX__ACQUIRE_TIMEOUT_S=600   # 等待空闲容器上限（秒）；0=不限制
NEXUS_SANDBOX__OOM_GRACE_MB=512
NEXUS_SANDBOX__WORKTREE_ROOT=.nexus/worktrees
NEXUS_SANDBOX__ALLOW_LOCAL_IN_PROD=false   # env=prod 时允许 local 沙箱（无隔离，需显式确认）
NEXUS_SANDBOX__MAX_OUTPUT_BYTES=200000

# --- 状态持久化 (Postgres / Redis) ---
NEXUS_POSTGRES__DSN=postgresql://nexus:nexus@localhost:5432/nexus
NEXUS_POSTGRES__ENABLED=false        # true 时启用 Postgres Checkpointer（断点续跑 / Time-Travel）
NEXUS_REDIS__URL=redis://localhost:6379/0
NEXUS_REDIS__ENABLED=false

# --- 智能体编排 ---
NEXUS_AGENT__MAX_ITERATIONS=6
NEXUS_AGENT__SAME_ERROR_STREAK=2      # 连续相同报错指纹阈值 → 熔断
NEXUS_AGENT__STALL_STREAK=2           # 连续无进展阈值 → 熔断
NEXUS_AGENT__TOKEN_BUDGET=120000
NEXUS_AGENT__CONTEXT_WINDOW=32000
NEXUS_AGENT__GRAPH_RECURSION_LIMIT=50
NEXUS_AGENT__N_HOP=2                  # 调用图 N 跳子图半径

# --- GitHub 集成 ---
NEXUS_GITHUB__TOKEN=                  # 创建 PR / 回评所需（repo scope）
NEXUS_GITHUB__WEBHOOK_SECRET=         # 未配置时 /webhooks/github 默认拒绝未签名请求（fail-closed）
NEXUS_GITHUB__ALLOW_UNVERIFIED_WEBHOOKS=false   # 仅联调环境可开启：放行无签名 Webhook（不安全）
NEXUS_GITHUB__AUTO_PR=true            # 修复成功后自动推送分支并创建 PR（需 TOKEN；无 Token 时静默跳过）
NEXUS_GITHUB__API_BASE=https://api.github.com
NEXUS_GITHUB__REPO_ROOT=              # 本地仓库根目录：<REPO_ROOT>/<repo_name> 映射 GitHub 仓库（Webhook 必需）
